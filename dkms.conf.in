PACKAGE_NAME="thunderbolt-rr"
PACKAGE_VERSION="@VERSION@"
BUILT_MODULE_NAME[0]="thunderbolt"
DEST_MODULE_LOCATION[0]="/updates/dkms"
MAKE[0]="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build CONFIG_USB4=m CONFIG_ACPI=y CONFIG_DEBUG_FS=y modules"
CLEAN="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build clean"
AUTOINSTALL="yes"
